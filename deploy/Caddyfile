# HTTPS for $DOMAIN (Let's Encrypt, automatic), forwarding everything — pages, API and the
# WebSocket — to the app container.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
}
