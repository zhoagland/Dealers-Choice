# Copy to deploy/.env and fill in (deploy/README.md Part 1). Never commit the filled-in file.

# Your domain, without https:// (Caddy gets its certificate).
DOMAIN=poker.example.com
# The same domain with https:// (sign-in redirects and cookie security use it).
PUBLIC_URL=https://poker.example.com

# Discord Developer Portal → your application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Only members of this Discord server can sign in (required unless DEV_MODE=1).
ALLOWED_GUILD_ID=
# Your Discord user id; more admins comma-separated.
ADMIN_DISCORD_IDS=

# Local testing only: sign in by name at /auth/dev?name=Ann, no Discord needed. Never on a public server.
DEV_MODE=0
