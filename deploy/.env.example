# Copy to deploy/.env (by hand) or ~/dealers-choice/.env (GitHub deploy workflow) and fill in
# (deploy/README.md). Never commit the filled-in file.

# The public address people open, with https:// (sign-in redirects and cookie security use it).
PUBLIC_URL=https://poker.example.com

# Discord Developer Portal → your application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Only members of this Discord server can sign in (required unless DEV_MODE=1).
ALLOWED_GUILD_ID=
# Your Discord user id; more admins comma-separated.
ADMIN_DISCORD_IDS=

# Where the app listens on this machine (a tunnel or your reverse proxy forwards to it).
DC_HTTP_BIND=127.0.0.1
DC_HTTP_PORT=8090

# --profile tunnel: the Cloudflare Tunnel token (Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# --profile caddy: your domain without https:// (Caddy gets its certificate).
DOMAIN=

# Extra services the deploy workflow starts with the app: "tunnel", "caddy", or empty.
DC_PROFILES=

# Local testing only: sign in by name at /auth/dev?name=Ann, no Discord. Never on a public server.
DEV_MODE=0
